-- SMART DISTANCE TP LIST
local function updateSmartTPList()
    for _, child in ipairs(smartScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local myHRP = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local count = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            count = count + 1
            local targetHRP = player.Character.HumanoidRootPart
            local distance = (myHRP.Position - targetHRP.Position).Magnitude

            local itemFrame = Instance.new("Frame")
            itemFrame.Size = UDim2.new(1, -5, 0, 30)
            itemFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            itemFrame.Parent = smartScroll
            Instance.new("UICorner", itemFrame).CornerRadius = UDim.new(0, 4)

            local pName = Instance.new("TextLabel")
            pName.Size = UDim2.new(0.65, 0, 0.7, 0)
            pName.Position = UDim2.new(0.02, 0, 0.05, 0)
            pName.Text = player.DisplayName .. " (" .. math.floor(distance) .. "s)"
            pName.TextColor3 = Color3.fromRGB(255, 255, 255)
            pName.Font = Enum.Font.SourceSans
            pName.TextSize = 11
            pName.TextXAlignment = Enum.TextXAlignment.Left
            pName.Parent = itemFrame

            local statusIndicator = Instance.new("Frame")
            statusIndicator.Size = UDim2.new(0.65, 0, 0.2, 0)
            statusIndicator.Position = UDim2.new(0.02, 0, 0.75, 0)
            statusIndicator.Parent = itemFrame

            local tpBtn = Instance.new("TextButton")
            tpBtn.Size = UDim2.new(0.28, 0, 0.8, 0)
            tpBtn.Position = UDim2.new(0.7, 0, 0.1, 0)
            tpBtn.Font = Enum.Font.SourceSansBold
            tpBtn.TextSize = 11
            tpBtn.Parent = itemFrame
            Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 4)

            if distance <= 900 then
                statusIndicator.BackgroundColor3 = Color3.fromRGB(50, 220, 50)
                tpBtn.Text = "TP"
                tpBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
                tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                tpBtn.MouseButton1Click:Connect(function()
                    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        localPlayer.Character.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
                    end
                end)
            elseif distance >= 1000 then
                statusIndicator.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
                tpBtn.Text = "Quá Xa"
                tpBtn.BackgroundColor3 = Color3.fromRGB(100, 40, 40)
                tpBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
            else
                statusIndicator.BackgroundColor3 = Color3.fromRGB(220, 180, 50)
                tpBtn.Text = "TP"
                tpBtn.BackgroundColor3 = Color3.fromRGB(180, 130, 0)
                tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                tpBtn.MouseButton1Click:Connect(function()
                    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        localPlayer.Character.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
                    end
                end)
            end
        end
    end
    smartScroll.CanvasSize = UDim2.new(0, 0, 0, count * 34)
end

-- TP TOOL
local function equipTPTool()
    local backpack = localPlayer:WaitForChild("Backpack")
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()

    if backpack:FindFirstChild("TP") or (character and character:FindFirstChild("TP")) then
        return
    end

    local tool = Instance.new("Tool")
    tool.Name = "TP"
    tool.RequiresHandle = false

    tool.Activated:Connect(function()
        local pos = mouse.Hit.Position
        if character and character:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        end
    end)

    tool.Parent = backpack
end

RunService.Stepped:Connect(function()
    pcall(equipTPTool)
end)

btnTPTool.MouseButton1Click:Connect(function()
    equipTPTool()
    btnTPTool.Text = "Đã Cấp TP Tool!"
    task.wait(1.5)
    btnTPTool.Text = "Nhận TP Tool (Teleport Click)"
end)

-- PLAYER LIST 3D & INSTANT TELEPORT
local selectedPlayerCard = nil

local function updatePlayer3DList()
    for _, child in ipairs(playerListScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local totalHeight = 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, -5, 0, 40)
            card.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            card.ClipsDescendants = true
            card.Parent = playerListScroll
            Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

            local vp = Instance.new("ViewportFrame")
            vp.Size = UDim2.new(0, 36, 0, 36)
            vp.Position = UDim2.new(0, 2, 0, 2)
            vp.BackgroundTransparency = 1
            vp.Parent = card

            if player.Character then
                player.Character.Archivable = true
                local charClon = player.Character:Clone()
                charClon.Parent = vp

                local cam = Instance.new("Camera")
                cam.Parent = vp
                vp.CurrentCamera = cam

                local head = charClon:FindFirstChild("Head") or charClon:FindFirstChild("HumanoidRootPart")
                if head then
                    cam.CFrame = CFrame.new(head.Position + Vector3.new(0, 0.5, 2.5), head.Position)
                end
            end

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(0.6, 0, 0.8, 0)
            nameLabel.Position = UDim2.new(0, 42, 0, 4)
            nameLabel.Text = player.DisplayName .. "\n@" .. player.Name
            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLabel.Font = Enum.Font.SourceSansBold
            nameLabel.TextSize = 11
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = card

            local selectBtn = Instance.new("TextButton")
            selectBtn.Size = UDim2.new(1, 0, 0, 40)
            selectBtn.BackgroundTransparency = 1
            selectBtn.Text = ""
            selectBtn.Parent = card

            local actionTPBtn = Instance.new("TextButton")
            actionTPBtn.Size = UDim2.new(0.9, 0, 0, 25)
            actionTPBtn.Position = UDim2.new(0.05, 0, 0, 42)
            actionTPBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 220)
            actionTPBtn.Text = "⚡ Dịch Chuyển Tới Đây (Bất Kể Khoảng Cách)"
            actionTPBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            actionTPBtn.Font = Enum.Font.SourceSansBold
            actionTPBtn.TextSize = 11
            actionTPBtn.Parent = card
            Instance.new("UICorner", actionTPBtn).CornerRadius = UDim.new(0, 4)

            actionTPBtn.MouseButton1Click:Connect(function()
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    localPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                end
            end)

            selectBtn.MouseButton1Click:Connect(function()
                if selectedPlayerCard == card then
                    card.Size = UDim2.new(1, -5, 0, 40)
                    selectedPlayerCard = nil
                else
                    if selectedPlayerCard then
                        selectedPlayerCard.Size = UDim2.new(1, -5, 0, 40)
                    end
                    card.Size = UDim2.new(1, -5, 0, 72)
                    selectedPlayerCard = card
                end
            end)

            totalHeight = totalHeight + 46
        end
    end
    playerListScroll.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 40)
end

