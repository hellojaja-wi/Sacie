-- LOGIC MỚI: AUTO CLAIM COINS (LƯU VỊ TRÍ + 90 GIÂY COOLDOWN)
task.spawn(function()
    while true do
        if autoClaimCoinsEnabled then
            pcall(function()
                local char = localPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")

                if hrp then
                    -- 1. Lưu lại tọa độ vị trí cuối cùng trước khi dịch chuyển
                    local originalCFrame = hrp.CFrame

                    -- 2. Tìm vị trí 8kCoinsGiver và dịch chuyển tới
                    local targetGiver = workspace:FindFirstChild("8kCoinsGiver", true)
                    if targetGiver then
                        local giverCFrame = targetGiver:IsA("BasePart") and targetGiver.CFrame or targetGiver:GetPivot()
                        hrp.CFrame = giverCFrame * CFrame.new(0, 3, 0)
                        task.wait(0.3) -- Chờ 0.3s để game cập nhật vị trí
                    end

                    -- 3. Gửi lệnh lấy tiền
                    local remote = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("mapManagerRemote")
                    remote:FireServer("claimCoins", "8kCoinsGiver")
                    task.wait(0.2)

                    -- 4. Dịch chuyển quay trở lại ngay vị trí ban đầu
                    hrp.CFrame = originalCFrame
                end
            end)

            -- Chờ đúng 1 phút 30 giây (90 giây) trước khi lấy lượt tiếp theo
            task.wait(90)
        else
            task.wait(1)
        end
    end
end)

